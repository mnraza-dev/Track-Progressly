# Clerk authentication. Configure the Supabase integration in both dashboards for cloud sync.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Optional: set both to enable cloud sync. Apply all database migrations first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Set in your hosting environment for deployed YouTube imports.
YOUTUBE_API_KEY=
